<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 공통 네트워크 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 위치 권한 (지오펜스/지도용) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 🔥 백그라운드 위치 서비스를 위한 추가 권한 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 🔥 백그라운드 서비스 안정성을 위한 권한 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 알림 권한 (Android 13+ 알림 표시용) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- OCR / 이미지 감시용 저장소 권한 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- 포그라운드 서비스 (ImageObserverService용) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GiftGuardlogin"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- ML Kit (한글 OCR 의존성 선언) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr-korean" />

        <!-- Google Maps API 키 -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyAX-KKZDUSHTBDAUFAdPCZ1rWU_Bw0F_pU" />

        <!-- 프로필 화면 (기존) -->
        <activity
            android:name=".ProfileActivity"
            android:exported="true"
            android:label="내 정보" />

        <!-- 로그인 화면 (앱 런처) -->
        <activity
            android:name=".GoogleLoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 지도 + 지오펜스 화면 -->
        <activity
            android:name=".MapsActivity"
            android:exported="true" />

        <!-- OCR 화면 -->
        <activity
            android:name=".OcrActivity"
            android:exported="true"
            android:label="@string/title_activity_ocr"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />

        <!-- 지오펜스 브로드캐스트 수신 -->
        <receiver
            android:name=".GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- 이미지 감지 포그라운드 서비스 -->
        <service
            android:name=".ImageObserverService"
            android:exported="true"
            android:foregroundServiceType="dataSync" />

        <!-- 🔥 백그라운드 위치 서비스 추가 -->
        <service
            android:name=".BackgroundLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


    </application>

</manifest>